<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      悬浮球和副屏取景窗要往机主那块屏上加窗口。这个权限只能由机主在系统设置里给,
      app 自己拿不到,所以两个悬浮窗默认都是关的。
      两个窗口都带 FLAG_NOT_FOCUSABLE —— 理由见 Overlay.kt 顶部。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 悬浮球的语音输入。用进程内的 SpeechRecognizer,不拉起识别界面 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 只在识别那几秒把悬浮窗服务升成 microphone 类型,见 OverlayService.micMode -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Android 11+ 默认看不见别的 app。不声明这一段,queryIntentActivities 返回近乎空,
      于是「把用户说的『计算器』解析成包名」这件事在自己的 PackageManager 里做不了。
      只查带 LAUNCHER 入口的 app,不申请 QUERY_ALL_PACKAGES —— 后者是敏感权限,
      上架要额外说明,而这里根本用不上。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          语音识别服务也要声明,否则包可见性会把它们过滤掉,
          SpeechRecognizer.isRecognitionAvailable 有可能因此报「这台机器没有语音识别」。
          实测:不声明时能看到的服务比 `pm query-services` 少。
        -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:theme="@style/WP"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          任务入口必须活在无障碍服务之外:权限跟着任务走(A11yGate),不跑任务时
          无障碍是关的,注册在它里面的接收器也就不在了。
          Android 8 起静态接收器收不到隐式广播,所以发广播时要带 -p 包名。
        -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.whalephone.agent.RUN" />
            </intent-filter>
        </receiver>

        <!-- 开机把机主上次留着的悬浮窗恢复回来,见 BootReceiver -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent-on-secondary-display" />
        </service>

        <!--
          悬浮窗的宿主。前台服务,因为悬浮球的意义就是「不打开 app 也在」;
          通知走最低优先级,点它就能把两个窗口一起收起。
        -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-invoked-floating-controls" />
        </service>

        <service
            android:name=".EyesAndHands"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
